{{!
    @template tiny_authory_tech/learn_more

    Template for displaying the learn more page for the Authory.tech plugin in TinyMCE editor.
    This template provides information about uses of Authory.tech.

    Example context (json):
    {
    }
}}

<div class="tiny_authory_tech-modal-container">
    <div class="tiny_authory_tech-modal-header-custom">
        <h1>{{#str}}learnmore_title, tiny_authory_tech{{/str}}</h1>
        <p>{{#str}}learnmore_subtitle, tiny_authory_tech{{/str}}</p>
    </div>

    <div class="p-4 p-md-5">

        <div class="row g-4">
            <!-- Premium Card -->
            <div class="col-12 mb-3">
                <div class="card tiny_authory_tech-pricing-card premium border-2 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h3 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_premium_title, tiny_authory_tech{{/str}}</h3>
                            <span class="tiny_authory_tech-card-price">{{#str}}learnmore_premium_price_prefix, tiny_authory_tech{{/str}}<span>199</span>{{#str}}learnmore_premium_price_suffix, tiny_authory_tech{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">
                            {{#str}}learnmore_premium_desc, tiny_authory_tech{{/str}}
                        </p>
                        <div>
                            <a href="https://authory.tech/premium-supported-community-and-limited/"
                                target="_blank" class="text-decoration-none">{{#str}}learnmore_premium_link, tiny_authory_tech{{/str}}</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Community Card -->
            <div class="col-12 mb-3">
                <div class="card tiny_authory_tech-pricing-card border-2 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h3 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_community_title, tiny_authory_tech{{/str}}</h3>
                            <span class="tiny_authory_tech-card-price">{{#str}}learnmore_community_price, tiny_authory_tech{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">
                            {{#str}}learnmore_community_desc, tiny_authory_tech{{/str}}
                        </p>
                        <div class="">
                            <a href="https://authory.tech/premium-supported-community-and-limited/"
                                target="_blank" class="btn btn-outline-primary btn-sm">{{#str}}learnmore_community_cta, tiny_authory_tech{{/str}}</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Limited Free Card -->
            <div class="col-12">
                <div class="card tiny_authory_tech-pricing-card border-2 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h3 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_limited_title, tiny_authory_tech{{/str}}</h3>
                            <span class="tiny_authory_tech-card-price">{{#str}}learnmore_limited_price, tiny_authory_tech{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">
                            {{#str}}learnmore_limited_desc, tiny_authory_tech{{/str}}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
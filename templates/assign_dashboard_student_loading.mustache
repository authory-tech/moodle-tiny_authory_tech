{{!
@template tiny_authory_tech/assign_dashboard_student_loading

Loading placeholder shown in a student's dashboard tab before their stats are fetched.

Example context (json):
{
    "fullname": "Jane Doe"
}
}}
<div class="authory-student-card">
    <h2 class="authory-student-name">{{fullname}}</h2>
    <p class="authory-student-loading">{{#str}}assign_dashboard_loading, tiny_authory_tech{{/str}}</p>
</div>
